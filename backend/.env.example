# ==============================================================================
# ChainProof Backend Environment Configuration
# ==============================================================================

# Allowed CORS Origins (comma-separated). By default includes localhost and https://chainproof-theta.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chainproof-theta.vercel.app

# AI Analyst Provider Selection
# Options: "deterministic" (default, zero keys required), "openai", "gemini", "anthropic", "ollama"
AI_ANALYST_PROVIDER=deterministic

# ------------------------------------------------------------------------------
# OpenAI Configuration (Optional - used if AI_ANALYST_PROVIDER=openai)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Google Gemini Configuration (Optional - used if AI_ANALYST_PROVIDER=gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Anthropic Claude Configuration (Optional - used if AI_ANALYST_PROVIDER=anthropic)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# Ollama Local Configuration (Optional - used if AI_ANALYST_PROVIDER=ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
