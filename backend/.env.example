# ==============================================================================
# ChainProof Enterprise Security Platform - Environment Configuration
# ==============================================================================

# Server Environment (production / development)
ENVIRONMENT=production

# API Documentation exposure in production (false by default for security)
ENABLE_DOCS=false

# Authentication and Session Security
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=

# Allowed CORS Origins (comma-separated, no wildcards in production)
CORS_ORIGINS=https://chainproof-theta.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,tauri://localhost
# Optional regex for dynamic preview deployments (keep empty in production)
CORS_ORIGIN_REGEX=

# AI Security Analyst Provider Selection
# Options: "deterministic" (default, zero external keys needed), "openai", "gemini", "anthropic", "ollama"
AI_ANALYST_PROVIDER=deterministic

# ------------------------------------------------------------------------------
# Sigstore Cosign Configuration
# ------------------------------------------------------------------------------
# Path to enterprise public key for signature verification (optional)
# COSIGN_PUBLIC_KEY=/etc/chainproof/cosign.pub

# ------------------------------------------------------------------------------
# Notifications Configuration
# ------------------------------------------------------------------------------
# Generic Webhook URL (Slack incoming webhook, Discord, Microsoft Teams, SIEM)
CHAINPROOF_WEBHOOK_URL=

# Mobile Push Notification Gateway (e.g. https://exp.host/--/api/v2/push/send)
EXPO_PUSH_GATEWAY_URL=https://exp.host/--/api/v2/push/send

# SMTP Email Notification Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@chainproof.io
SMTP_USE_TLS=true
ALERT_EMAIL_TO=

# ------------------------------------------------------------------------------
# AI Provider Keys (Only needed if AI_ANALYST_PROVIDER is not "deterministic")
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
