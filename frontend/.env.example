# ChainProof Frontend Environment Configuration
# API Base URL for backend service (No secret keys should ever be exposed here)
#
# Local Development:
# VITE_API_URL=http://127.0.0.1:8000
#
# Production (Set in Vercel Project Settings > Environment Variables):
# VITE_API_URL=https://<your-public-fastapi-backend-url>
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_ENV=production
VITE_APP_NAME=ChainProof

